# VECTOR Frontend Environment Variables (Vercel / Production / Local)

# Base URL of the VECTOR FastAPI Backend (e.g., deployed on Render or Fly.io)
# Example: https://vector-backend.onrender.com/api or http://127.0.0.1:8000/api
VITE_API_URL=http://127.0.0.1:8000/api

# Base WebSocket URL for real-time mission events and Playwright live screencast
# Example: wss://vector-backend.onrender.com or ws://127.0.0.1:8000
# (If omitted, automatically derived from VITE_API_URL protocol ws:// or wss://)
VITE_WS_URL=ws://127.0.0.1:8000
