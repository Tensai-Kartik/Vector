# VECTOR: Autonomous Web Operator Configuration

# Server
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173

# LLM Planning Engine
# Provider options: 'mock' (deterministic offline tests) | 'gemini'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# API-first Integrations
# Optional GitHub personal access token for higher rate limits on repository/release lookups
GITHUB_TOKEN=

# Browser Automation & Security Guardrails
BROWSER_HEADLESS=true
BROWSER_SLOWMO_MS=100
SCREENSHOT_STREAM_INTERVAL_MS=300
MAX_MISSION_TIMEOUT_SECONDS=180
MAX_STEP_RETRIES=2
MAX_DOWNLOAD_SIZE_BYTES=10485760

# Allowed Domains (comma-separated). Restrict to safe origins or authorized domains.
ALLOWED_DOMAINS=localhost,127.0.0.1,api.github.com,github.com

# Paths
DATABASE_URL=sqlite:///./data/vector.db
ARTIFACTS_DIR=./data/artifacts
