# VECTOR: Autonomous Web Operator Configuration

# Server
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173

# LLM Planning Engine
# Provider options: 'deterministic' (default, ultra-fast built-in planner & 21/21 benchmarks) | 'gemini'
LLM_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# API-first Integrations
# Optional GitHub personal access token for higher rate limits on repository/release lookups
GITHUB_TOKEN=

# Browser Automation & Security Guardrails
BROWSER_HEADLESS=true
BROWSER_SLOWMO_MS=0
SCREENSHOT_STREAM_INTERVAL_MS=800
MAX_MISSION_TIMEOUT_SECONDS=180
MAX_STEP_RETRIES=2
MAX_DOWNLOAD_SIZE_BYTES=10485760

# Allowed Domains (comma-separated). Set '*' to permit all public web targets while preserving SSRF guardrails.
ALLOWED_DOMAINS=localhost,127.0.0.1,api.github.com,github.com,youtube.com,google.com,wikipedia.org,*

# Paths
DATABASE_URL=sqlite:///./data/vector.db
ARTIFACTS_DIR=./data/artifacts
